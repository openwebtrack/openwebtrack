DATABASE_URL=

# Auth
ORIGIN=http://localhost:8424
DISABLE_REGISTER=false
AUTH_SECRET=
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=

# Insights
# TYPESAFE_API_KEY=

# Email (set one of the following)
# Required in SaaS mode (PUBLIC_SAAS_MODE=true) for passwordless magic-link sign-in
# SENDER_EMAIL=openwebtrack@yourdomain.com
# RESEND_API_KEY=
# MAILEROO_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Cloud self-tracking (only used when PUBLIC_SAAS_MODE=true)
# PUBLIC_OWT_WEBSITE_ID=
# PUBLIC_OWT_DOMAIN=openwebtrack.one
# PUBLIC_OWT_SCRIPT_URL=https://cloud.openwebtrack.one/script.js
