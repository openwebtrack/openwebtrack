# Database
DATABASE_URL=

# Auth
ORIGIN=http://localhost:8424
DISABLE_REGISTER=false
AUTH_SECRET=

# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=

# Email (set one of the following)
# SENDER_EMAIL=openwebtrack@yourdomain.com

# RESEND_API_KEY=

# MAILEROO_API_KEY=

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# SaaS / Billing (Stripe) - required when PUBLIC_SAAS_MODE=true
# (pricing tiers are defined in code - env only carries the Stripe Price IDs)
# PUBLIC_SAAS_MODE=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# First-time subscribers get a 7-day free trial (no card required, no extra Price ID needed).
# STRIPE_TRIAL_DAYS=7
# Webhook endpoint: {ORIGIN}/api/auth/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created,
#         customer.subscription.updated, customer.subscription.deleted

# Other
# CRON_SECRET=
